{
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/llms/:id.txt", "destination": "/api/llms/:id" },
    { "source": "/((?!api/|llms/|sitemap.xml|robots.txt).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-weekly-reports",
      "schedule": "0 9 * * *"
    }
  ]
}
