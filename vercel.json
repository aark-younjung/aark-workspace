{
  "framework": "vite",
  "functions": {
    "api/cron-weekly-reports.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|sitemap.xml|robots.txt|llms.txt).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-weekly-reports",
      "schedule": "0 9 * * *"
    }
  ]
}
